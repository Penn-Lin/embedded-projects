// ================= 按键检测函数 =================
bool checkButton(int pin) {
  static unsigned long lastDebounceTime[4] = { 0 };
  const int debounceDelay = 50;
  int index = 0;
  if (pin == BUTTON_K1) index = 0;
  else if (pin == BUTTON_K2) index = 1;
  else if (pin == BUTTON_K3) index = 2;
  else if (pin == BUTTON_K4) index = 3;

  if (digitalRead(pin) == LOW) {
    if (millis() - lastDebounceTime[index] > debounceDelay) {
      lastDebounceTime[index] = millis();
      return true;
    }
  }
  return false;
}

// ================= 显示函数优化 =================
void drawBadge() {
  u8g2.clearBuffer();
  // 关键修改：使用支持PROGMEM的显示方法
  u8g2.drawXBMP(0, 0, 128, 64, party_logo);
  u8g2.sendBuffer();
}

// ================= 音乐播放 =================
void handleMusic() {
  const uint16_t* currentNotes;
  const uint16_t* currentDurations;
  int noteCount;

  if (soundMode == 0) {
    currentNotes = defaultNotes;
    currentDurations = defaultDurations;
    noteCount = sizeof(defaultNotes) / sizeof(uint16_t);
  } else {
    currentNotes = dongfanghongNotes;
    currentDurations = dongfanghongDurations;
    noteCount = sizeof(dongfanghongNotes) / sizeof(uint16_t);
  }

  if (millis() - previousMusicTime >= noteDuration) {
    if (currentNote < noteCount) {
      // 从Flash读取数据
      uint16_t note = pgm_read_word(&currentNotes[currentNote]);
      uint16_t duration = pgm_read_word(&currentDurations[currentNote]);

      tone(BUZZER_PIN, note, duration);
      previousMusicTime = millis();
      currentNote++;
    } else {
      currentNote = 0;
    }
  }
}

// ================= 主程序 =================
void setup() {
  u8g2.begin();

  pinMode(BUZZER_PIN, OUTPUT);
  pinMode(BUTTON_K1, INPUT_PULLUP);
  pinMode(BUTTON_K2, INPUT_PULLUP);
  pinMode(BUTTON_K3, INPUT_PULLUP);
  pinMode(BUTTON_K4, INPUT_PULLUP);
  u8g2.clearBuffer();
  u8g2.sendBuffer();
}

void loop() {
  // 检测K1（系统总开关）
  if (checkButton(BUTTON_K1)) {
    systemActive = !systemActive;
    noTone(BUZZER_PIN);
    badgeMode = false;  // 强制退出徽章模式
    if (!systemActive) {
      u8g2.clearBuffer();
      u8g2.sendBuffer();
    }
    currentNote = 0;
    delay(300);
  }

  if (!systemActive) return;  // 系统未激活时直接返回

  // 检测K4（徽章模式 - 显示党徽并播放《没有共产党就没有新中国》）
  if (checkButton(BUTTON_K4)) {
    badgeMode = !badgeMode;
    currentNote = 0;
    previousMusicTime = millis();
    noTone(BUZZER_PIN);  // 停止当前音乐

    delay(300);
  }

  // K2动画切换
  if (checkButton(BUTTON_K2)) {
    animationMode = (animationMode + 1) % 2;
    currentNote = 0;
    u8g2.clearBuffer();  // 清屏
    // 重置动画参数
    xOffset = 0;
    waveOffset = 0.0;
    delay(300);  // 增加短暂延迟确保显示稳定
  }

  // 检测K3（音效切换 - 在《东方红》和《小星星》之间切换）
  if (checkButton(BUTTON_K3) && !badgeMode) {  // 仅在非徽章模式下切换
    soundMode = (soundMode + 1) % 2;           // 0:小星星, 1:东方红
    currentNote = 0;
    noTone(BUZZER_PIN);
    delay(300);
  }

  // 处理徽章模式
  if (badgeMode) {
    drawBadge();  // 显示党徽
    // 播放《没有共产党就没有新中国》
    playMeiyouGongchandang();  // 新增的播放函数
  } else {
    // 非徽章模式：更新动画
    if (animationMode == 0) {  // 五角星模式
      u8g2.clearBuffer();
      drawStar(xOffset);
      u8g2.sendBuffer();
      xOffset += moveDirection * MOVE_SPEED;
      if (xOffset >= MAX_OFFSET || xOffset <= -MAX_OFFSET) moveDirection *= -1;
    } else {  // 红旗模式
      waveOffset += waveSpeed;
      if (waveOffset > TWO_PI) waveOffset -= TWO_PI;
      drawFlag();
    }
  }

  // 统一音乐播放逻辑
  if (systemActive && !badgeMode) {
    handleMusic();
  }

  delay(30);
}