// 播放《没有共产党就没有新中国》
void playMeiyouGongchandang() {
  static int noteIndex = 0;
  int noteCount = sizeof(customNotes) / sizeof(int);

  if (millis() - previousMusicTime >= noteDuration) {
    if (noteIndex < noteCount) {
      tone(BUZZER_PIN, customNotes[noteIndex], customDurations[noteIndex]);
      previousMusicTime = millis();
      noteIndex++;
    } else {
      noteIndex = 0;  // 循环播放
    }
  }
}

